// граф.ps — разрешение графа зависимостей: единая версия на имя пакета,
// обнаружение конфликтов версий и циклов.
импорт манифест
импорт семвер
импорт гит
импорт кэш
импорт фс
импорт "строки"
импорт "слог"

// Ref для checkout: точный коммит/ветка/тег как есть (оТочный), либо
// наибольший git-тег, удовлетворяющий semver-ограничению.
функ определить_реф(источник: Строка, ограничение: семвер.Ограничение, логгер: слог.Логгер) -> Результат(Строка, Ошибка)
	если ограничение.тип_ == семвер.ТипОграничения.оТочный тогда
		возврат Результат.Успех(ограничение.исходная_строка)
	конец

	пер теги_рез = гит.список_тегов(источник, логгер)
	если теги_рез.ошибка() тогда
		возврат Результат.Неудача(теги_рез.причина())
	конец

	пер подходящая = семвер.наибольшая_подходящая(теги_рез.значение(), ограничение)
	если не подходящая.есть() тогда
		возврат Результат.Неудача(Ошибка("граф", "нет версии, удовлетворяющей ограничению, для \(источник)"))
	конец
	Результат.Успех(подходящая.значение())
конец

функ разрешить_одну(
	завис: манифест.Зависимость,
	цепочка: Массив(Строка),
	разрешено: Соответствие(Строка, манифест.Lock_Запись),
	логгер: слог.Логгер
) -> Результат(Число, Ошибка)
	пер огр_рез = семвер.разобрать_ограничение(завис.версия)
	если огр_рез.ошибка() тогда
		возврат Результат.Неудача(огр_рез.причина())
	конец
	пер ограничение = огр_рез.значение()

	пер реф_рез = определить_реф(завис.источник, ограничение, логгер)
	если реф_рез.ошибка() тогда
		возврат Результат.Неудача(реф_рез.причина())
	конец
	пер реф = реф_рез.значение()

	пер путь_кэша = кэш.путь_источника(завис.источник)

	// клонировать_или_обновить (не голое "если нет — клонировать") — см.
	// найденный там баг: без извлечения свежих тегов в уже существующий
	// кэш, реф, только что найденный определить_реф выше (через
	// гит.список_тегов, всегда актуальный сетевой вызов), мог быть
	// физически недоступен для checkout в локальном кэше.
	пер подготовка = кэш.клонировать_или_обновить(завис.источник, путь_кэша, логгер)
	если подготовка.ошибка() тогда
		возврат Результат.Неудача(подготовка.причина())
	конец

	пер переключ = гит.переключиться_на(путь_кэша, реф, логгер)
	если переключ.ошибка() тогда
		возврат Результат.Неудача(переключ.причина())
	конец

	пер коммит_рез = гит.текущий_коммит(путь_кэша, логгер)
	если коммит_рез.ошибка() тогда
		возврат Результат.Неудача(коммит_рез.причина())
	конец
	пер коммит = коммит_рез.значение()

	пер завис_манифест_рез = манифест.загрузить("\(путь_кэша)/pan.toml")
	если завис_манифест_рез.ошибка() тогда
		возврат Результат.Неудача(Ошибка("граф", "у зависимости \(завис.источник) нет читаемого pan.toml"))
	конец
	пер завис_манифест = завис_манифест_рез.значение()
	пер имя = завис_манифест.имя

	// Цикл: имя уже среди ПРЕДКОВ в текущей рекурсии (не в общем "разрешено").
	если цепочка.содержит(имя) тогда
		возврат Результат.Неудача(Ошибка("граф", "циклическая зависимость: '\(имя)' уже резолвится выше по цепочке (\(строки.соединить(цепочка, " -> ")))"))
	конец

	// Конфликт: имя уже разрешено с другим источником/коммитом.
	если разрешено.есть(имя) тогда
		пер существующая = разрешено[имя]
		если существующая.источник <> завис.источник или существующая.коммит <> коммит тогда
			возврат Результат.Неудача(Ошибка(
				"граф",
				"конфликт версий для '\(имя)': \(существующая.источник)@\(существующая.коммит) vs \(завис.источник)@\(коммит)"
			))
		конец
		возврат Результат.Успех(0)
	конец

	логгер.инфо("разрешено \(имя) -> \(реф) (\(коммит))")

	пер зависит_от: Массив(Строка) = массив()
	разрешено[имя] = манифест.Lock_Запись(имя, завис.источник, реф, коммит, зависит_от)

	пер новая_цепочка: Массив(Строка) = массив()
	для звено в цепочка цикл
		новая_цепочка.добавить(звено)
	конец
	новая_цепочка.добавить(имя)

	разрешить_зависимости(завис_манифест.зависимости, новая_цепочка, разрешено, логгер)
конец

функ разрешить_зависимости(
	зависимости: Соответствие(Строка, манифест.Зависимость),
	цепочка: Массив(Строка),
	разрешено: Соответствие(Строка, манифест.Lock_Запись),
	логгер: слог.Логгер
) -> Результат(Число, Ошибка)
	для (_, завис) в зависимости.записи() цикл
		пер рез = разрешить_одну(завис, цепочка, разрешено, логгер)
		если рез.ошибка() тогда
			возврат рез
		конец
	конец
	Результат.Успех(0)
конец

/// Разрешает полный граф зависимостей манифеста (включая транзитивные):
/// единая версия на canonical-имя во всём графе, конфликты и циклы — хард-ошибка.
экспорт функ разрешить_граф(м: манифест.Манифест, логгер: слог.Логгер) -> Результат(Массив(манифест.Lock_Запись), Ошибка)
	пер разрешено: Соответствие(Строка, манифест.Lock_Запись) = соответствие()
	пер пустая_цепочка: Массив(Строка) = массив()
	пер рез = разрешить_зависимости(м.зависимости, пустая_цепочка, разрешено, логгер)
	если рез.ошибка() тогда
		возврат Результат.Неудача(рез.причина())
	конец

	пер список: Массив(манифест.Lock_Запись) = массив()
	для (_, запись) в разрешено.записи() цикл
		список.добавить(запись)
	конец
	Результат.Успех(список)
конец
