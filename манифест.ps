// манифест.ps — разбор/сериализация pan.toml, тип Манифест и Зависимость.
импорт фс
импорт ос
импорт "кодирование/toml" как томл

экспорт тип Манифест = структура
	имя: Строка
	версия: Строка
	точка_входа: Строка
	// Версия паноса (ос.версия_паноса()), которым пакет был создан
	// (pan init) — справочно, на резолв зависимостей не влияет.
	версия_паноса: Строка
	зависимости: Соответствие(Строка, Зависимость)
конец

экспорт тип Зависимость = структура
	источник: Строка
	версия: Строка
	алиас: Строка
конец

/// Разрешённая зависимость (прямая или транзитивная) в pan.lock.
экспорт тип Lock_Запись = структура
	имя: Строка
	источник: Строка
	разрешённая_версия: Строка
	коммит: Строка
	зависит_от: Массив(Строка)
конец

реализация томл.ИзTOML для Зависимость
	функ заполнить_из_toml(это: Зависимость, значение: томл.Значение) -> Опция(Ошибка)
		это.источник = значение.поле("источник").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.версия = значение.поле("версия").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.алиас = значение.поле("алиас").получить(томл.Значение.Строка("")).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация томл.ВTOML для Зависимость
	функ в_toml(это: Зависимость) -> томл.Значение
		пер т: Соответствие(Строка, томл.Значение) = соответствие()
		т["источник"] = томл.Значение.Строка(это.источник)
		т["версия"] = томл.Значение.Строка(это.версия)
		если это.алиас <> "" тогда
			т["алиас"] = томл.Значение.Строка(это.алиас)
		конец
		томл.Значение.Таблица(т)
	конец
конец

реализация томл.ИзTOML для Манифест
	функ заполнить_из_toml(это: Манифест, значение: томл.Значение) -> Опция(Ошибка)
		это.имя = значение.поле("имя").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.версия = значение.поле("версия").получить(томл.Значение.Строка("0.1.0")).как_строку().получить("0.1.0")
		это.точка_входа = значение.поле("точка_входа").получить(томл.Значение.Строка("start.ps")).как_строку().получить("start.ps")
		это.версия_паноса = значение.поле("версия_паноса").получить(томл.Значение.Строка("")).как_строку().получить("")

		пер пустая_таблица_зависимостей: Соответствие(Строка, томл.Значение) = соответствие()
		пер завис_знач = значение.поле("зависимости").получить(томл.Значение.Таблица(пустая_таблица_зависимостей))
		пер завис_таблица = выбор завис_знач
			томл.Значение.Таблица(т) -> т
			_ -> пустая_таблица_зависимостей
		конец

		пер результат: Соответствие(Строка, Зависимость) = соответствие()
		для (имя_завис, знач_завис) в завис_таблица.записи() цикл
			пер зав = Зависимость("", "", "")
			зав.заполнить_из_toml(знач_завис)
			результат[имя_завис] = зав
		конец
		это.зависимости = результат

		Опция.Нет()
	конец
конец

реализация томл.ВTOML для Манифест
	функ в_toml(это: Манифест) -> томл.Значение
		пер т: Соответствие(Строка, томл.Значение) = соответствие()
		т["имя"] = томл.Значение.Строка(это.имя)
		т["версия"] = томл.Значение.Строка(это.версия)
		т["точка_входа"] = томл.Значение.Строка(это.точка_входа)
		если это.версия_паноса <> "" тогда
			т["версия_паноса"] = томл.Значение.Строка(это.версия_паноса)
		конец

		пер завис_т: Соответствие(Строка, томл.Значение) = соответствие()
		для (имя_завис, зав) в это.зависимости.записи() цикл
			завис_т[имя_завис] = зав.в_toml()
		конец
		т["зависимости"] = томл.Значение.Таблица(завис_т)

		томл.Значение.Таблица(т)
	конец
конец

/// Новый манифест с именем пакета, версией 0.1.0, точкой входа start.ps,
/// текущей версией паноса (pan init) и пустыми зависимостями.
экспорт функ новый_манифест(имя: Строка) -> Манифест
	пер пустые_зависимости: Соответствие(Строка, Зависимость) = соответствие()
	Манифест(имя, "0.1.0", "start.ps", ос.версия_паноса(), пустые_зависимости)
конец

/// Сохраняет манифест как TOML по указанному пути.
экспорт функ сохранить(манифест: Манифест, путь: Строка) -> Результат(Число, Ошибка)
	фс.записать(путь, томл.сериализовать_из(манифест))
конец

функ манифест_из_текста(текст: Строка) -> Результат(Манифест, Ошибка)
	пер пустые_зависимости: Соответствие(Строка, Зависимость) = соответствие()
	пер м = Манифест("", "", "", "", пустые_зависимости)
	пер ошибка_опц = томл.разобрать_в(м, текст)
	выбор ошибка_опц
		Опция.Есть(ош) -> Результат.Неудача(ош)
		Опция.Нет -> Результат.Успех(м)
	конец
конец

/// Читает и разбирает манифест по указанному пути.
экспорт функ загрузить(путь: Строка) -> Результат(Манифест, Ошибка)
	выбор фс.прочитать(путь)
		Результат.Успех(текст) -> манифест_из_текста(текст)
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

реализация томл.ВTOML для Lock_Запись
	функ в_toml(это: Lock_Запись) -> томл.Значение
		пер т: Соответствие(Строка, томл.Значение) = соответствие()
		т["имя"] = томл.Значение.Строка(это.имя)
		т["источник"] = томл.Значение.Строка(это.источник)
		т["разрешённая_версия"] = томл.Значение.Строка(это.разрешённая_версия)
		т["коммит"] = томл.Значение.Строка(это.коммит)

		пер зависит_список: Массив(томл.Значение) = массив()
		для имя_завис в это.зависит_от цикл
			зависит_список.добавить(томл.Значение.Строка(имя_завис))
		конец
		т["зависит_от"] = томл.Значение.Список(зависит_список)

		томл.Значение.Таблица(т)
	конец
конец

функ пустой_список_значений() -> Массив(томл.Значение)
	пер результат: Массив(томл.Значение) = массив()
	результат
конец

функ пустой_массив_строк() -> Массив(Строка)
	пер результат: Массив(Строка) = массив()
	результат
конец

реализация томл.ИзTOML для Lock_Запись
	функ заполнить_из_toml(это: Lock_Запись, значение: томл.Значение) -> Опция(Ошибка)
		это.имя = значение.поле("имя").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.источник = значение.поле("источник").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.разрешённая_версия = значение.поле("разрешённая_версия").получить(томл.Значение.Строка("")).как_строку().получить("")
		это.коммит = значение.поле("коммит").получить(томл.Значение.Строка("")).как_строку().получить("")

		пер список_знач = значение.поле("зависит_от").получить(томл.Значение.Список(пустой_список_значений()))
		пер список = выбор список_знач
			томл.Значение.Список(эл) -> эл
			_ -> пустой_список_значений()
		конец
		пер результат = пустой_массив_строк()
		для эл в список цикл
			результат.добавить(эл.как_строку().получить(""))
		конец
		это.зависит_от = результат

		Опция.Нет()
	конец
конец

/// Сохраняет разрешённый граф зависимостей как pan.lock по указанному пути.
экспорт функ сохранить_lock(записи: Массив(Lock_Запись), путь: Строка) -> Результат(Число, Ошибка)
	пер записи_toml: Массив(томл.Значение) = массив()
	для запись в записи цикл
		записи_toml.добавить(запись.в_toml())
	конец

	пер корень: Соответствие(Строка, томл.Значение) = соответствие()
	корень["версия_формата"] = томл.Значение.Целое(1)
	корень["пакеты"] = томл.Значение.Список(записи_toml)

	фс.записать(путь, томл.сериализовать(томл.Значение.Таблица(корень)))
конец

функ пакеты_из_lock_значения(значение: томл.Значение) -> Массив(Lock_Запись)
	пер список_знач = значение.поле("пакеты").получить(томл.Значение.Список(пустой_список_значений()))
	пер список = выбор список_знач
		томл.Значение.Список(эл) -> эл
		_ -> пустой_список_значений()
	конец
	пер результат: Массив(Lock_Запись) = массив()
	для эл в список цикл
		пер запись = Lock_Запись("", "", "", "", пустой_массив_строк())
		запись.заполнить_из_toml(эл)
		результат.добавить(запись)
	конец
	результат
конец

/// Проверяет целостность lock-файла: нет дублирующихся имён, все имена
/// в зависит_от существуют среди пакетов (FR-009).
функ проверить_lock(записи: Массив(Lock_Запись)) -> Опция(Ошибка)
	пер имена: Массив(Строка) = массив()
	для запись в записи цикл
		если имена.содержит(запись.имя) тогда
			возврат Опция.Есть(Ошибка("lock", "pan.lock повреждён: имя '" + запись.имя + "' встречается более одного раза"))
		конец
		имена.добавить(запись.имя)
	конец

	для запись в записи цикл
		для завис_имя в запись.зависит_от цикл
			если не имена.содержит(завис_имя) тогда
				возврат Опция.Есть(Ошибка("lock", "pan.lock повреждён: '" + запись.имя + "' ссылается на несуществующий пакет '" + завис_имя + "'"))
			конец
		конец
	конец

	Опция.Нет()
конец

функ lock_из_текста(текст: Строка) -> Результат(Массив(Lock_Запись), Ошибка)
	пер разобрано = томл.разобрать(текст)
	если разобрано.ошибка() тогда
		возврат Результат.Неудача(разобрано.причина())
	конец

	пер пусто_знач = томл.Значение.Булево(ложь)
	пер записи = пакеты_из_lock_значения(разобрано.получить(пусто_знач))

	пер проверка = проверить_lock(записи)
	если проверка.есть() тогда
		возврат Результат.Неудача(проверка.значение())
	конец

	Результат.Успех(записи)
конец

/// Читает и проверяет pan.lock по указанному пути (FR-009).
экспорт функ загрузить_lock(путь: Строка) -> Результат(Массив(Lock_Запись), Ошибка)
	выбор фс.прочитать(путь)
		Результат.Успех(текст) -> lock_из_текста(текст)
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

/// Поднимается вверх по дереву директорий от текущей, ища pan.toml (корень пакета).
экспорт функ найти_корень_пакета() -> Результат(Строка, Ошибка)
	пер текущая = "."
	пер глубина: Целое = 0
	пока глубина < 64 цикл
		если фс.есть(текущая + "/pan.toml") тогда
			возврат Результат.Успех(текущая)
		конец
		текущая = текущая + "/.."
		глубина = глубина + 1
	конец
	Результат.Неудача(Ошибка("манифест", "pan.toml не найден ни в текущей директории, ни выше по дереву"))
конец
