// гит.ps — обёртка git clone/checkout/ls-remote поверх ос.выполнить.
импорт "ос"
импорт "строки"
импорт "слог"

функ гит_ошибка(данные: (Число, Строка, Строка)) -> Ошибка
	Ошибка("гит", строки.обрезать(данные.2))
конец

/// Клонирует git-репозиторий источник в директорию путь_назначения.
экспорт функ клонировать(источник: Строка, путь_назначения: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	логгер.отладка("git clone \(источник) \(путь_назначения)")
	пер рез = ос.выполнить("git", массив("clone", источник, путь_назначения), "")
	если рез.ошибка() тогда
		логгер.ошибка("git clone \(источник): \(рез.причина().сообщение)")
		возврат Результат.Неудача(рез.причина())
	конец
	пер данные = рез.значение()
	если данные.0 <> 0 тогда
		пер ош = гит_ошибка(данные)
		логгер.ошибка("git clone \(источник): \(ош.сообщение)")
		возврат Результат.Неудача(ош)
	конец
	Результат.Успех(данные.0)
конец

/// Забирает свежие ref'ы (в т.ч. новые теги) с удалённого источника в уже
/// клонированный репозиторий (путь) — без него уже клонированный кэш
/// (обеспечить_кэш, кэш.ps) никогда не увидит теги, появившиеся ПОСЛЕ
/// первого клонирования: git checkout работает только с уже известными
/// локально ref'ами, свежих с сервера сам по себе не подтягивает.
экспорт функ извлечь_теги(путь: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	логгер.отладка("git fetch --tags --force (в '\(путь)')")
	пер рез = ос.выполнить("git", массив("fetch", "--tags", "--force"), путь)
	если рез.ошибка() тогда
		логгер.ошибка("git fetch --tags (в '\(путь)'): \(рез.причина().сообщение)")
		возврат Результат.Неудача(рез.причина())
	конец
	пер данные = рез.значение()
	если данные.0 <> 0 тогда
		пер ош = гит_ошибка(данные)
		логгер.ошибка("git fetch --tags (в '\(путь)'): \(ош.сообщение)")
		возврат Результат.Неудача(ош)
	конец
	Результат.Успех(данные.0)
конец

/// Переключает уже клонированный репозиторий (путь) на реф (тег/ветка/коммит).
экспорт функ переключиться_на(путь: Строка, реф: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	логгер.отладка("git checkout \(реф) (в '\(путь)')")
	пер рез = ос.выполнить("git", массив("checkout", реф), путь)
	если рез.ошибка() тогда
		логгер.ошибка("git checkout \(реф) (в '\(путь)'): \(рез.причина().сообщение)")
		возврат Результат.Неудача(рез.причина())
	конец
	пер данные = рез.значение()
	если данные.0 <> 0 тогда
		пер ош = гит_ошибка(данные)
		логгер.ошибка("git checkout \(реф) (в '\(путь)'): \(ош.сообщение)")
		возврат Результат.Неудача(ош)
	конец
	Результат.Успех(данные.0)
конец

/// Точный коммит (SHA), на который сейчас выставлен репозиторий в пути.
экспорт функ текущий_коммит(путь: Строка, логгер: слог.Логгер) -> Результат(Строка, Ошибка)
	пер рез = ос.выполнить("git", массив("rev-parse", "HEAD"), путь)
	если рез.ошибка() тогда
		логгер.ошибка("git rev-parse HEAD (в '\(путь)'): \(рез.причина().сообщение)")
		возврат Результат.Неудача(рез.причина())
	конец
	пер данные = рез.значение()
	если данные.0 <> 0 тогда
		пер ош = гит_ошибка(данные)
		логгер.ошибка("git rev-parse HEAD (в '\(путь)'): \(ош.сообщение)")
		возврат Результат.Неудача(ош)
	конец
	Результат.Успех(строки.обрезать(данные.1))
конец

функ разобрать_теги(вывод: Строка) -> Массив(Строка)
	пер строки_вывода = строки.разбить(вывод, "\n")
	пер результат: Массив(Строка) = массив()
	для строка в строки_вывода цикл
		если строки.содержит(строка, "refs/tags/") тогда
			пер части = строки.разбить(строка, "refs/tags/")
			пер n = длина(части)
			если n >= 2 тогда
				пер тег = части[n - 1]
				если строки.заканчивается_на(тег, "^{}") тогда
					тег = строки.срез(тег, 0, длина(тег) - 3)
				конец
				если не результат.содержит(тег) тогда
					результат.добавить(тег)
				конец
			конец
		конец
	конец
	результат
конец

/// Список тегов удалённого git-репозитория источник (без клонирования).
экспорт функ список_тегов(источник: Строка, логгер: слог.Логгер) -> Результат(Массив(Строка), Ошибка)
	логгер.отладка("git ls-remote --tags \(источник)")
	пер рез = ос.выполнить("git", массив("ls-remote", "--tags", источник), "")
	если рез.ошибка() тогда
		логгер.ошибка("git ls-remote --tags \(источник): \(рез.причина().сообщение)")
		возврат Результат.Неудача(рез.причина())
	конец
	пер данные = рез.значение()
	если данные.0 <> 0 тогда
		пер ош = гит_ошибка(данные)
		логгер.ошибка("git ls-remote --tags \(источник): \(ош.сообщение)")
		возврат Результат.Неудача(ош)
	конец
	Результат.Успех(разобрать_теги(данные.1))
конец
