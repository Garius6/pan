// кэш.ps — локальный кэш пакетов и раскладка в директорию модули/.
импорт "ос"
импорт фс
импорт "строки"
импорт манифест
импорт гит
импорт "слог"

функ домашняя_директория() -> Строка
	выбор ос.окружение("HOME")
		Опция.Есть(путь) -> путь
		Опция.Нет -> "/tmp"
	конец
конец

функ санитизировать(текст: Строка) -> Строка
	пер результат = ""
	для i = 0 по длина(текст) - 1 цикл
		пер символ = строки.срез(текст, i, i + 1)
		если строки.цифра_или_буква(символ) тогда
			результат = результат + символ
		иначе
			результат = результат + "_"
		конец
	конец
	результат
конец

/// Директория локального кэша для источника — общая для всех проектов на машине.
экспорт функ путь_источника(источник: Строка) -> Строка
	"\(домашняя_директория())/.pan/cache/\(санитизировать(источник))"
конец

/// Копирует один файл (фс не даёт готового примитива копирования).
функ скопировать_файл(из: Строка, куда: Строка) -> Результат(Число, Ошибка)
	выбор фс.прочитать(из)
		Результат.Успех(содержимое) -> фс.записать(куда, содержимое)
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

/// Рекурсивно копирует дерево директории (файлы и поддиректории), пропуская
/// .git — нужно для раскладки многофайловых зависимостей в модули/<имя>/
/// (см. разложить_запись): единственный примитив копирования у фс — файл за
/// файлом (скопировать_файл выше), для целого дерева обходим
/// список_директории вручную и рекурсируем на поддиректории — различает
/// файл/директорию через фс.это_директория, т.к. список_директории отдаёт
/// только голые имена, без пометки вида.
функ скопировать_дерево(из: Строка, куда: Строка) -> Результат(Число, Ошибка)
	пер создание = фс.создать_директорию(куда)
	если создание.ошибка() тогда
		возврат создание
	конец

	пер список = фс.список_директории(из)
	если список.ошибка() тогда
		возврат Результат.Неудача(список.причина())
	конец

	для имя в список.значение() цикл
		если имя == ".git" тогда
			продолжить
		конец

		пер путь_из = "\(из)/\(имя)"
		пер путь_куда = "\(куда)/\(имя)"

		если фс.это_директория(путь_из) тогда
			пер рек = скопировать_дерево(путь_из, путь_куда)
			если рек.ошибка() тогда
				возврат рек
			конец
		иначе
			пер копия = скопировать_файл(путь_из, путь_куда)
			если копия.ошибка() тогда
				возврат копия
			конец
		конец
	конец

	Результат.Успех(0)
конец

/// Точка входа зависимости-задачи (файл, который спавнится отдельным
/// процессом, см. start.ps::команда_task) — берётся из её собственного
/// pan.toml, "start.pns" при его отсутствии. Путь может указывать и на
/// кэш (~/.pan/cache/...), и на уже разложенный модули/<имя>/ — в обоих
/// местах лежит одна и та же копия pan.toml зависимости.
экспорт функ точка_входа_зависимости(путь_кэша: Строка) -> Строка
	выбор манифест.загрузить("\(путь_кэша)/pan.toml")
		Результат.Успех(м) -> м.точка_входа
		Результат.Неудача(_) -> "start.pns"
	конец
конец

// НАЙДЕННЫЙ БАГ (не входил в исходный дизайн, обнаружен ДВАЖДЫ
// продублированным — здесь и в граф.ps::разрешить_одну): если путь_кэша
// уже существует (обычный случай — второй/третий вызов на той же
// машине), обе копии раньше сразу шли на переключиться_на БЕЗ
// извлечь_теги — новые теги/коммиты, появившиеся на источнике ПОСЛЕ
// первого клонирования, были НЕВИДИМЫ локальному кэшу навсегда: git
// checkout работает только с уже известными локально ref'ами.
// Разрешение версии (определить_реф, граф.ps) идёт по гит.список_тегов
// (сетевой вызов, всегда актуален) — но ЛЮБОЙ checkout после этого шёл
// в локальный кэш, который мог не знать про только что найденный тег:
// "pathspec ... did not match any file(s) known to git". Извлечена в
// эту ОБЩУЮ функцию именно ПОТОМУ, что дублирование самого паттерна
// (clone-if-missing/checkout) и было причиной, что фикс однажды уже
// пропустил один из двух вызывающих — граф.ps резолвит зависимости
// (нужен доступ к pan.toml каждой, для транзитивных) ДО того, как
// кэш.разложить_запись вообще вызывается.
/// Клонирует источник в путь_кэша, если там ещё ничего нет, иначе
/// подтягивает свежие теги/коммиты в уже существующий кэш — не делает
/// checkout сам, вызывающий сам решает, на какой реф переключиться.
экспорт функ клонировать_или_обновить(источник: Строка, путь_кэша: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	если не фс.есть(путь_кэша) тогда
		логгер.инфо("кэш пуст, клонирую \(источник)")
		возврат гит.клонировать(источник, путь_кэша, логгер)
	конец
	логгер.отладка("кэш уже есть (\(путь_кэша)), обновляю теги")
	гит.извлечь_теги(путь_кэша, логгер)
конец

/// Гарантирует, что источник клонирован в кэш и выставлен ровно на
/// зафиксированный в pan.lock коммит — нужен для `pan install` с чистым
/// (ещё не наполненным) кэшем, например сразу после клонирования проекта.
функ обеспечить_кэш(запись: манифест.Lock_Запись, путь_кэша: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	пер подготовка = клонировать_или_обновить(запись.источник, путь_кэша, логгер)
	если подготовка.ошибка() тогда
		возврат подготовка
	конец
	гит.переключиться_на(путь_кэша, запись.коммит, логгер)
конец

/// Раскладывает одну разрешённую зависимость в модули/<имя>/ — целиком
/// (минус .git, см. скопировать_дерево). Ничего не генерируется и не
/// дублируется: "точка_входа" в pan.toml — понятие для исполняемых
/// задач/приложений (спавнятся отдельным процессом, см. команда_run в
/// start.ps), а не для библиотек. У библиотеки нет "точки входа" в этом
/// смысле — есть корневой файл с публичным API, и автор зависимости САМ
/// называет его "индекс.pns" (соглашение, как lib.rs в Rust — отдельное от
/// имени исполняемого входа, как main.rs). Раз он физически лежит в дереве
/// зависимости, компилятор panos находит его для импорт("имя") сам
/// (директория+индекс-конвенция, см. core/resolver.odin::
/// resolve_import_dir_index_path) — и его относительные импорты
/// (`./помощник`) видят соседей на месте, т.к. ничего никуда не выносилось.
/// Зависимость без индекс.pns просто не импортируется как библиотека — это
/// нормально, если она задумана только как задача/приложение.
экспорт функ разложить_запись(запись: манифест.Lock_Запись, корень_пакета: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	пер путь_кэша = путь_источника(запись.источник)

	пер обеспечено = обеспечить_кэш(запись, путь_кэша, логгер)
	если обеспечено.ошибка() тогда
		возврат обеспечено
	конец

	пер создание = фс.создать_директорию("\(корень_пакета)/модули")
	если создание.ошибка() тогда
		возврат создание
	конец

	логгер.отладка("раскладываю \(запись.имя) в \(корень_пакета)/модули/\(запись.имя)")
	скопировать_дерево(путь_кэша, "\(корень_пакета)/модули/\(запись.имя)")
конец

/// Раскладывает все разрешённые зависимости в директорию модули/ корня пакета.
экспорт функ разложить_в_модули(записи: Массив(манифест.Lock_Запись), корень_пакета: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	пер i: Целое = 0
	пока i < длина(записи) цикл
		пер рез = разложить_запись(записи[i], корень_пакета, логгер)
		если рез.ошибка() тогда
			возврат рез
		конец
		i = i + 1
	конец
	Результат.Успех(Число(длина(записи)))
конец

/// Удаляет из модули/ и файл-точку-входа, и полное дерево (см.
/// разложить_запись) более не нужной зависимости. фс.удалить_директорию не
/// различает файл/директорию и не паникует на отсутствующем пути (см. её
/// докстринг в core), поэтому оба вызова безопасны независимо от того,
/// раскладывалась ли эта запись ДО появления модули/<имя>/ (старые записи —
/// только .ps-файл).
экспорт функ убрать_из_модулей(имя_пакета: Строка, корень_пакета: Строка, логгер: слог.Логгер) -> Результат(Число, Ошибка)
	логгер.отладка("убираю \(имя_пакета) из \(корень_пакета)/модули")
	фс.удалить_директорию("\(корень_пакета)/модули/\(имя_пакета)")
	фс.удалить_директорию("\(корень_пакета)/модули/\(имя_пакета).ps")
конец
