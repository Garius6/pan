// семвер.ps — парсинг и сравнение semver-версий и ограничений (^, ~, >=).
импорт "строки"

экспорт тип Семвер = структура
	мажор: Целое
	минор: Целое
	патч: Целое
конец

экспорт тип ТипОграничения = перечисление
	оКарет
	оТильда
	оБольшеРавно
	оТочный
конец

экспорт тип Ограничение = структура
	тип_: ТипОграничения
	версия: Семвер
	исходная_строка: Строка
конец

реализация Семвер
	функ меньше(это: Семвер, другая: Семвер) -> Булево
		если это.мажор <> другая.мажор тогда
			возврат это.мажор < другая.мажор
		конец
		если это.минор <> другая.минор тогда
			возврат это.минор < другая.минор
		конец
		это.патч < другая.патч
	конец

	функ равно(это: Семвер, другая: Семвер) -> Булево
		это.мажор == другая.мажор и это.минор == другая.минор и это.патч == другая.патч
	конец

	функ меньше_или_равно(это: Семвер, другая: Семвер) -> Булево
		это.меньше(другая) или это.равно(другая)
	конец
конец

/// Разбирает строку вида "1.2.3" (или "v1.2.3" — распространённый префикс
/// git-тегов) в Семвер.
экспорт функ разобрать_версию(текст: Строка) -> Результат(Семвер, Ошибка)
	пер без_префикса = если длина(текст) > 0 и (текст[0] == "v" или текст[0] == "V") тогда
		строки.срез(текст, 1, длина(текст))
	иначе
		текст
	конец
	пер части = строки.разбить(без_префикса, ".")
	если длина(части) <> 3 тогда
		возврат Результат.Неудача(Ошибка("семвер", "версия должна быть в формате мажор.минор.патч: " + текст))
	конец

	пер мажор_р = строки.в_число(части[0])
	пер минор_р = строки.в_число(части[1])
	пер патч_р = строки.в_число(части[2])

	если мажор_р.ошибка() или минор_р.ошибка() или патч_р.ошибка() тогда
		возврат Результат.Неудача(Ошибка("семвер", "не числовая версия: " + текст))
	конец

	Результат.Успех(Семвер(Целое(мажор_р.значение()), Целое(минор_р.значение()), Целое(патч_р.значение())))
конец

функ разобрать_с_префиксом(текст: Строка, смещение: Целое, тип_: ТипОграничения) -> Результат(Ограничение, Ошибка)
	пер остаток = строки.срез(текст, смещение, длина(текст))
	выбор разобрать_версию(остаток)
		Результат.Успех(верс) -> Результат.Успех(Ограничение(тип_, верс, ""))
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

/// Разбирает ограничение версии: "^1.2.3", "~1.2.3", ">=1.2.3", либо точный коммит/ветку/тег как есть.
экспорт функ разобрать_ограничение(текст: Строка) -> Результат(Ограничение, Ошибка)
	если длина(текст) == 0 тогда
		возврат Результат.Неудача(Ошибка("семвер", "пустое ограничение версии"))
	конец

	если текст[0] == "^" тогда
		возврат разобрать_с_префиксом(текст, 1, ТипОграничения.оКарет)
	конец
	если текст[0] == "~" тогда
		возврат разобрать_с_префиксом(текст, 1, ТипОграничения.оТильда)
	конец
	если длина(текст) >= 2 и строки.срез(текст, 0, 2) == ">=" тогда
		возврат разобрать_с_префиксом(текст, 2, ТипОграничения.оБольшеРавно)
	конец

	// Не похоже на семвер-диапазон — точный коммит/ветка/тег как есть.
	Результат.Успех(Ограничение(ТипОграничения.оТочный, Семвер(0, 0, 0), текст))
конец

/// Проверяет, удовлетворяет ли версия ограничению.
экспорт функ удовлетворяет(версия: Семвер, ограничение: Ограничение) -> Булево
	если ограничение.тип_ == ТипОграничения.оТочный тогда
		возврат истина
	конец
	если ограничение.тип_ == ТипОграничения.оБольшеРавно тогда
		возврат ограничение.версия.меньше_или_равно(версия)
	конец
	если ограничение.тип_ == ТипОграничения.оТильда тогда
		возврат ограничение.версия.меньше_или_равно(версия) и версия.мажор == ограничение.версия.мажор и версия.минор == ограничение.версия.минор
	конец
	// оКарет
	ограничение.версия.меньше_или_равно(версия) и версия.мажор == ограничение.версия.мажор
конец

функ версия_кандидата(кандидат: Строка) -> Опция(Семвер)
	выбор разобрать_версию(кандидат)
		Результат.Успех(верс) -> Опция.Есть(верс)
		Результат.Неудача(_) -> Опция.Нет()
	конец
конец

/// Из списка версий-кандидатов возвращает наибольшую, удовлетворяющую ограничению (если есть).
экспорт функ наибольшая_подходящая(кандидаты: Массив(Строка), ограничение: Ограничение) -> Опция(Строка)
	пер лучшая_строка = ""
	пер лучшая_версия = Семвер(0, 0, 0)
	пер нашли = ложь

	для кандидат в кандидаты цикл
		пер версия_опц = версия_кандидата(кандидат)
		если версия_опц.есть() тогда
			пер верс = версия_опц.значение()
			если удовлетворяет(верс, ограничение) тогда
				если (не нашли) или лучшая_версия.меньше(верс) тогда
					лучшая_строка = кандидат
					лучшая_версия = верс
					нашли = истина
				конец
			конец
		конец
	конец

	если нашли тогда
		Опция.Есть(лучшая_строка)
	иначе
		Опция.Нет()
	конец
конец
