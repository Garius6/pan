импорт "ввод_вывод" как ио
импорт "ос"
импорт "строки"
импорт фс
импорт манифест
импорт граф
импорт кэш
импорт гит
импорт семвер
импорт "слог"

тип Флаг = структура
    наименование: Строка
    тип_: ТипФлага
конец

тип ТипФлага = перечисление
    тСтрока
    тЧисло
    тБулево
конец

тип ЗначениеФлага = перечисление
    фСтрока(Строка)
    фЧисло(Число)
    фБулево(Булево)
конец

реализация ЗначениеФлага

    функ вСтроку(это: ЗначениеФлага) -> Строка
        возврат выбор это
            фСтрока(с) -> "Строка(\(с))"
            фЧисло(ч) -> "Число(\(строки.из_числа(ч)))"
            фБулево(б) -> если б тогда "Булево(истина)" иначе "Булево(ложь)" конец
        конец
    конец

конец

тип Конфигурация = структура
    флаги: Соответствие(Строка, Флаг)
конец

функ новая_конфигурация() -> Конфигурация
    пер флаги: Соответствие(Строка, Флаг) = соответствие()
    возврат Конфигурация(флаги)
конец

реализация Конфигурация

    функ добавить_флаг(это: Конфигурация, флаг: Флаг) -> Пусто
        это.флаги[флаг.наименование] = флаг
    конец

    функ распарсить_флаги(это: Конфигурация, аргументы: Массив(Строка)) -> Соответствие(Строка, ЗначениеФлага)

        пер результат: Соответствие(Строка, ЗначениеФлага) = соответствие()

        для сч = 0 по длина(аргументы) - 1 цикл
            пер аргумент = аргументы[сч]

            // Не похоже на флаг (пустая строка или без ведущего '-') —
            // позиционный аргумент. Пропускаем.
            если длина(аргумент) == 0 или аргумент[0] <> "-" тогда
                продолжить
            конец

            пер без_дефиса = строки.срез(аргумент, 1, длина(аргумент))

            // Форма "флаг=значение" — ищем '=' посимвольно, строки.
            // не даёт готового "найти подстроку".
            пер позиция_равно: Целое = -1
            для j = 0 по длина(без_дефиса) - 1 цикл
                если без_дефиса[j] == "=" тогда
                    позиция_равно = j
                    прервать
                конец
            конец

            пер имя_флага = без_дефиса
            если позиция_равно <> -1 тогда
                имя_флага = строки.срез(без_дефиса, 0, позиция_равно)
            конец

            если не это.флаги.есть(имя_флага) тогда
                паника("Необъявленный флаг: \(имя_флага)")
            конец

            пер флаг = это.флаги[имя_флага]

            если флаг.тип_ == ТипФлага.тБулево тогда
                результат[имя_флага] = ЗначениеФлага.фБулево(истина)
            иначе
                // "пер значение: Строка" без инициализатора не поддержан
                // грамматикой ("пер" всегда требует "= выражение") —
                // значение вычисляем как результат если-выражения; ветка
                // без "=" завершается голым выражением аргументы[сч], оно
                // и становится значением ветки (как везде в этом файле,
                // см. вСтроку() выше).
                пер значение = если позиция_равно <> -1 тогда
                    строки.срез(без_дефиса, позиция_равно + 1, длина(без_дефиса))
                иначе
                    если сч == длина(аргументы) - 1 тогда
                        паника("Флагу '\(имя_флага)' нужно значение")
                    конец
                    // Реально сдвигаем сч — следующая итерация возьмёт
                    // аргумент ПОСЛЕ значения, а не само значение повторно.
                    сч = сч + 1
                    аргументы[сч]
                конец
                если флаг.тип_ == ТипФлага.тЧисло тогда
                    результат[имя_флага] = ЗначениеФлага.фЧисло(строки.в_число(значение).значение())
                иначе
                    результат[имя_флага] = ЗначениеФлага.фСтрока(значение)
                конец
            конец
        конец

        возврат результат

    конец

конец

функ последний_сегмент_пути(путь: Строка) -> Строка
    пер части = строки.разбить(путь, "/")
    пер n = длина(части)
    если n == 0 тогда
        возврат путь
    конец
    части[n - 1]
конец

// pwd — единственный способ узнать имя текущей директории без отдельного
// builtin'а под это одно значение: переиспользуем ос.выполнить (уже
// добавлен для git/дочернего panos) вместо третьего builtin'а ради
// одной узкой надобности.
функ имя_текущей_директории() -> Строка
    пер рез = ос.выполнить("/bin/pwd", массив(), "")
    выбор рез
        Результат.Успех(данные) -> последний_сегмент_пути(строки.обрезать(данные.1))
        Результат.Неудача(_) -> "pan-package"
    конец
конец

функ команда_init() -> Пусто
    если фс.есть("pan.toml") тогда
        паника("pan init: pan.toml уже существует")
    конец

    пер имя_пакета = имя_текущей_директории()
    пер новый = манифест.новый_манифест(имя_пакета)
    пер сохранение = манифест.сохранить(новый, "pan.toml")
    если сохранение.ошибка() тогда
        паника("pan init: не удалось сохранить pan.toml: \(сохранение.причина().сообщение)")
    конец

    пер запись_старта = фс.записать("start.pns", "импорт \"ввод_вывод\" как ио\n\nфунк старт() -> Пусто\n    ио.строка(\"привет из \(имя_пакета)\")\nконец\n")
    если запись_старта.ошибка() тогда
        паника("pan init: не удалось создать start.pns: \(запись_старта.причина().сообщение)")
    конец

    ио.строка("Инициализирован пакет '\(имя_пакета)'")
конец

функ команда_нереализована(имя: Строка) -> Пусто
    ио.строка("pan \(имя): ещё не реализовано")
конец

функ хвост_строк(массив: Массив(Строка), от: Целое) -> Массив(Строка)
    пер результат: Массив(Строка) = массив()
    пер i = от
    пока i < длина(массив) цикл
        результат.добавить(массив[i])
        i = i + 1
    конец
    результат
конец

функ последний_сегмент_источника(источник: Строка) -> Строка
    пер очищенный = если строки.заканчивается_на(источник, ".git") тогда
        строки.срез(источник, 0, длина(источник) - 4)
    иначе
        источник
    конец
    последний_сегмент_пути(очищенный)
конец

функ найти_запись_по_источнику(записи: Массив(манифест.Lock_Запись), источник: Строка) -> Опция(манифест.Lock_Запись)
    для запись в записи цикл
        если запись.источник == источник тогда
            возврат Опция.Есть(запись)
        конец
    конец
    Опция.Нет()
конец

функ предварить(первый: Строка, остальные: Массив(Строка)) -> Массив(Строка)
    пер результат: Массив(Строка) = массив()
    результат.добавить(первый)
    для эл в остальные цикл
        результат.добавить(эл)
    конец
    результат
конец

// Раскладка — директория модули/<имя>/ (целое дерево зависимости, см.
// кэш.ps::разложить_запись), не отдельный .ps-файл — того больше нет.
функ модули_присутствуют(записи: Массив(манифест.Lock_Запись), корень: Строка) -> Булево
    для запись в записи цикл
        если не фс.есть("\(корень)/модули/\(запись.имя)") тогда
            возврат ложь
        конец
    конец
    истина
конец

функ команда_run(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    пер корень_рез = манифест.найти_корень_пакета()
    если корень_рез.ошибка() тогда
        паника("pan run: \(корень_рез.причина().сообщение)")
    конец
    пер корень = корень_рез.значение()

    пер м_рез = манифест.загрузить("\(корень)/pan.toml")
    если м_рез.ошибка() тогда
        паника("pan run: не удалось прочитать pan.toml: \(м_рез.причина().сообщение)")
    конец
    пер м = м_рез.значение()

    если м.зависимости.длина() > 0 тогда
        если не фс.есть("\(корень)/pan.lock") тогда
            паника("pan run: в pan.toml есть зависимости, но нет pan.lock — выполни 'pan install'")
        конец
        пер lock_рез = манифест.загрузить_lock("\(корень)/pan.lock")
        если lock_рез.ошибка() тогда
            паника("pan run: \(lock_рез.причина().сообщение)")
        конец
        пер записи = lock_рез.значение()
        если (не все_зависимости_в_lock(м, записи)) или (не модули_присутствуют(записи, корень)) тогда
            паника("pan run: зависимости из pan.toml не установлены — выполни 'pan install'")
        конец
    конец

    логгер.отладка("запускаю \(м.точка_входа)")
    пер рез = ос.выполнить("panos", предварить(м.точка_входа, аргументы), корень)
    если рез.ошибка() тогда
        логгер.ошибка("не удалось запустить \(м.точка_входа): \(рез.причина().сообщение)")
        паника("pan run: не удалось запустить panos: \(рез.причина().сообщение)")
    конец
    пер данные = рез.значение()
    ио.печать(данные.1)
    если данные.2 <> "" тогда
        ио.печать(данные.2)
    конец
    // Точный exit code дочернего panos — ровно тем же кодом завершается сам pan.
    ос.завершить(данные.0)
конец

// pan task <имя> [аргументы...] — спавнит ЗАВИСИМОСТЬ отдельным процессом,
// а не импортирует её. Задача — обычная зависимость (добавленная как
// любая другая через pan add), у которой есть точка_входа и старт() —
// вместо библиотечного индекс.ps (см. кэш.ps::разложить_запись докстринг:
// одно и то же дерево модули/<имя>/ обслуживает оба сценария, задача и
// библиотека — просто разные файлы внутри него, и pan.toml зависимости
// сам решает, какими файлами она себя предлагает). Никакой отдельной
// секции в pan.toml потребителя не нужно — имя задачи это просто имя уже
// объявленной зависимости.
функ команда_task(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    если длина(аргументы) < 1 тогда
        паника("pan task: нужно имя задачи (pan task <имя> [аргументы...])")
    конец
    пер имя_задачи = аргументы[0]
    пер остальные = хвост_строк(аргументы, 1)

    пер корень_рез = манифест.найти_корень_пакета()
    если корень_рез.ошибка() тогда
        паника("pan task: \(корень_рез.причина().сообщение)")
    конец
    пер корень = корень_рез.значение()

    пер м_рез = манифест.загрузить("\(корень)/pan.toml")
    если м_рез.ошибка() тогда
        паника("pan task: не удалось прочитать pan.toml: \(м_рез.причина().сообщение)")
    конец
    пер м = м_рез.значение()

    если не м.зависимости.есть(имя_задачи) тогда
        паника("pan task: '\(имя_задачи)' не найдена среди зависимостей — сначала 'pan add \(имя_задачи) ...'")
    конец

    пер путь_модуля = "\(корень)/модули/\(имя_задачи)"
    если не фс.есть(путь_модуля) тогда
        паника("pan task: зависимость '\(имя_задачи)' не установлена — выполни 'pan install'")
    конец

    пер точка_входа = кэш.точка_входа_зависимости(путь_модуля)

    логгер.отладка("запускаю задачу '\(имя_задачи)' (\(точка_входа))")
    пер рез = ос.выполнить("panos", предварить("\(путь_модуля)/\(точка_входа)", остальные), корень)
    если рез.ошибка() тогда
        логгер.ошибка("не удалось запустить задачу '\(имя_задачи)': \(рез.причина().сообщение)")
        паника("pan task: не удалось запустить '\(имя_задачи)': \(рез.причина().сообщение)")
    конец
    пер данные = рез.значение()
    ио.печать(данные.1)
    если данные.2 <> "" тогда
        ио.печать(данные.2)
    конец
    ос.завершить(данные.0)
конец

функ команда_add(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    если длина(аргументы) < 1 тогда
        паника("pan add: нужен источник зависимости (pan add <источник> [версия] [синоним])")
    конец
    пер источник = аргументы[0]
    пер версия = если длина(аргументы) >= 2 тогда аргументы[1] иначе ">=0.0.0" конец
    пер синоним = если длина(аргументы) >= 3 тогда аргументы[2] иначе "" конец

    пер м_рез = манифест.загрузить("pan.toml")
    если м_рез.ошибка() тогда
        паника("pan add: нет pan.toml — сначала выполни 'pan init'")
    конец
    пер м = м_рез.значение()

    пер временный_ключ = если синоним <> "" тогда синоним иначе последний_сегмент_источника(источник) конец
    м.зависимости[временный_ключ] = манифест.Зависимость(источник, версия, синоним)

    пер граф_рез = граф.разрешить_граф(м, логгер)
    если граф_рез.ошибка() тогда
        паника("pan add: \(граф_рез.причина().сообщение) (если это разные пакеты с одинаковым именем — добавь третий аргумент <синоним>)")
    конец
    пер записи = граф_рез.значение()

    пер найденная = найти_запись_по_источнику(записи, источник)
    если не найденная.есть() тогда
        паника("pan add: внутренняя ошибка — не удалось определить canonical-имя добавленной зависимости")
    конец
    пер запись_завис = найденная.значение()
    пер каноническое_имя = запись_завис.имя

    пер настоящий_ключ = если синоним <> "" тогда синоним иначе каноническое_имя конец
    если настоящий_ключ <> временный_ключ тогда
        м.зависимости.удалить(временный_ключ)
    конец
    м.зависимости[настоящий_ключ] = манифест.Зависимость(источник, версия, синоним)

    пер сохр_манифест = манифест.сохранить(м, "pan.toml")
    если сохр_манифест.ошибка() тогда
        паника("pan add: не удалось сохранить pan.toml: \(сохр_манифест.причина().сообщение)")
    конец

    пер сохр_lock = манифест.сохранить_lock(записи, "pan.lock")
    если сохр_lock.ошибка() тогда
        паника("pan add: не удалось сохранить pan.lock: \(сохр_lock.причина().сообщение)")
    конец

    пер раскл = кэш.разложить_в_модули(записи, ".", логгер)
    если раскл.ошибка() тогда
        паника("pan add: не удалось разложить зависимости в модули/: \(раскл.причина().сообщение)")
    конец

    ио.строка("Добавлена зависимость '\(каноническое_имя)' (\(запись_завис.разрешённая_версия))")
конец

функ имена_из_записей(записи: Массив(манифест.Lock_Запись)) -> Массив(Строка)
    пер результат: Массив(Строка) = массив()
    для запись в записи цикл
        результат.добавить(запись.имя)
    конец
    результат
конец

функ старые_имена_lock() -> Массив(Строка)
    пер пусто: Массив(Строка) = массив()
    если не фс.есть("pan.lock") тогда
        возврат пусто
    конец
    выбор манифест.загрузить_lock("pan.lock")
        Результат.Успех(старые) -> имена_из_записей(старые)
        Результат.Неудача(_) -> пусто
    конец
конец

функ убрать_отсутствующие(старые: Массив(Строка), новые: Массив(Строка), логгер: слог.Логгер) -> Пусто
    для имя в старые цикл
        если не новые.содержит(имя) тогда
            кэш.убрать_из_модулей(имя, ".", логгер)
        конец
    конец
конец

функ источник_есть_в_записях(источник: Строка, записи: Массив(манифест.Lock_Запись)) -> Булево
    для запись в записи цикл
        если запись.источник == источник тогда
            возврат истина
        конец
    конец
    ложь
конец

функ все_зависимости_в_lock(м: манифест.Манифест, записи: Массив(манифест.Lock_Запись)) -> Булево
    для (_, завис) в м.зависимости.записи() цикл
        если не источник_есть_в_записях(завис.источник, записи) тогда
            возврат ложь
        конец
    конец
    истина
конец

функ команда_install(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    пер м_рез = манифест.загрузить("pan.toml")
    если м_рез.ошибка() тогда
        паника("pan install: нет pan.toml — сначала выполни 'pan init'")
    конец
    пер м = м_рез.значение()

    если фс.есть("pan.lock") тогда
        пер lock_рез = манифест.загрузить_lock("pan.lock")
        если lock_рез.ошибка() тогда
            паника("pan install: \(lock_рез.причина().сообщение)")
        конец
        пер записи = lock_рез.значение()

        если все_зависимости_в_lock(м, записи) тогда
            пер раскл = кэш.разложить_в_модули(записи, ".", логгер)
            если раскл.ошибка() тогда
                паника("pan install: не удалось разложить зависимости: \(раскл.причина().сообщение)")
            конец
            ио.строка("Установлено из pan.lock (\(строки.из_числа(длина(записи))) пакетов)")
            возврат
        конец

        ио.строка("В pan.toml есть зависимости, отсутствующие в pan.lock — разрешаю заново")
    конец

    пер граф_рез = граф.разрешить_граф(м, логгер)
    если граф_рез.ошибка() тогда
        паника("pan install: \(граф_рез.причина().сообщение)")
    конец
    пер новые_записи = граф_рез.значение()

    пер сохр_lock = манифест.сохранить_lock(новые_записи, "pan.lock")
    если сохр_lock.ошибка() тогда
        паника("pan install: не удалось сохранить pan.lock: \(сохр_lock.причина().сообщение)")
    конец

    пер раскл2 = кэш.разложить_в_модули(новые_записи, ".", логгер)
    если раскл2.ошибка() тогда
        паника("pan install: не удалось разложить зависимости: \(раскл2.причина().сообщение)")
    конец

    ио.строка("Установлено (\(строки.из_числа(длина(новые_записи))) пакетов)")
конец

// pan version <patch|minor|major|X.Y.Z> — бампает версию в pan.toml,
// коммитит и создаёт annotated git-тег vX.Y.Z ЛОКАЛЬНО. Никогда не
// пушит сама (см. проектную конвенцию — push только по явному запросу
// пользователя, тот же принцип у npm version: коммит+тег без push).
функ команда_version(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    если длина(аргументы) < 1 тогда
        паника("pan version: нужен уровень бампа (patch|minor|major) или явная версия X.Y.Z")
    конец
    пер уровень = аргументы[0]

    пер м_рез = манифест.загрузить("pan.toml")
    если м_рез.ошибка() тогда
        паника("pan version: нет pan.toml")
    конец
    пер м = м_рез.значение()

    пер текущая_рез = семвер.разобрать_версию(м.версия)
    если текущая_рез.ошибка() тогда
        паника("pan version: текущая версия в pan.toml не семвер: \(текущая_рез.причина().сообщение)")
    конец
    пер текущая = текущая_рез.значение()

    // Не вложенные if-выражения ("если ... иначе если ... конец") — у
    // panos нет "иначе если" в грамматике, а вложенное if-выражение как
    // хвост иначе-ветки ломает унификацию типов ветвей (реальный баг
    // компилятора, найденный запуском: "ветви 'если' возвращают разные
    // типы" даже когда оба типа буквально Семвер). Обходится плоскими
    // if-СТАТЕМЕНТАМИ с переприсваиванием — тот же паттерн, что уже
    // использует распарсить_флаги() выше (сч = сч + 1).
    пер новая = текущая
    если уровень == "patch" тогда
        новая = семвер.бампнуть_патч(текущая)
    конец
    если уровень == "minor" тогда
        новая = семвер.бампнуть_минор(текущая)
    конец
    если уровень == "major" тогда
        новая = семвер.бампнуть_мажор(текущая)
    конец
    если уровень <> "patch" и уровень <> "minor" и уровень <> "major" тогда
        пер явная_рез = семвер.разобрать_версию(уровень)
        если явная_рез.ошибка() тогда
            паника("pan version: '\(уровень)' — не patch/minor/major и не X.Y.Z")
        конец
        новая = явная_рез.значение()
    конец

    м.версия = семвер.форматировать(новая)

    пер сохр = манифест.сохранить(м, "pan.toml")
    если сохр.ошибка() тогда
        паника("pan version: не удалось сохранить pan.toml: \(сохр.причина().сообщение)")
    конец

    пер тег = "v\(м.версия)"

    пер добавлено = гит.добавить_все(".", логгер)
    если добавлено.ошибка() тогда
        паника("pan version: git add: \(добавлено.причина().сообщение)")
    конец

    пер закоммичено = гит.закоммитить(".", "chore: версия \(м.версия)", логгер)
    если закоммичено.ошибка() тогда
        паника("pan version: git commit: \(закоммичено.причина().сообщение)")
    конец

    пер тегирование = гит.создать_тег(".", тег, "версия \(м.версия)", логгер)
    если тегирование.ошибка() тогда
        паника("pan version: git tag: \(тегирование.причина().сообщение)")
    конец

    ио.строка("Версия \(м.версия), тег \(тег) создан локально. Не забудь: git push && git push --tags")
конец

функ команда_remove(аргументы: Массив(Строка), логгер: слог.Логгер) -> Пусто
    если длина(аргументы) < 1 тогда
        паника("pan remove: нужно имя зависимости")
    конец
    пер имя = аргументы[0]

    пер м_рез = манифест.загрузить("pan.toml")
    если м_рез.ошибка() тогда
        паника("pan remove: нет pan.toml")
    конец
    пер м = м_рез.значение()

    если не м.зависимости.есть(имя) тогда
        паника("pan remove: зависимость '\(имя)' не найдена в pan.toml")
    конец

    пер старые = старые_имена_lock()

    м.зависимости.удалить(имя)

    пер сохр_манифест = манифест.сохранить(м, "pan.toml")
    если сохр_манифест.ошибка() тогда
        паника("pan remove: не удалось сохранить pan.toml: \(сохр_манифест.причина().сообщение)")
    конец

    пер граф_рез = граф.разрешить_граф(м, логгер)
    если граф_рез.ошибка() тогда
        паника("pan remove: не удалось пересчитать граф: \(граф_рез.причина().сообщение)")
    конец
    пер записи = граф_рез.значение()

    пер сохр_lock = манифест.сохранить_lock(записи, "pan.lock")
    если сохр_lock.ошибка() тогда
        паника("pan remove: не удалось сохранить pan.lock: \(сохр_lock.причина().сообщение)")
    конец

    убрать_отсутствующие(старые, имена_из_записей(записи), логгер)

    ио.строка("Удалена зависимость '\(имя)'")
конец

функ старт() -> Пусто
    пер аргументы = ос.аргументы()
    если длина(аргументы) == 0 тогда
        ио.строка("Использование: pan <init|add|remove|install|run|task|version> [аргументы]")
        возврат
    конец

    пер команда = аргументы[0]
    пер логгер = слог.логгер().с_уровнем(слог.Уровень.Инфо).с_тегом("pan")

    если команда == "init" тогда
        команда_init()
        возврат
    конец

    если команда == "add" тогда
        команда_add(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    если команда == "remove" тогда
        команда_remove(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    если команда == "install" тогда
        команда_install(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    если команда == "run" тогда
        команда_run(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    если команда == "task" тогда
        команда_task(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    если команда == "version" тогда
        команда_version(хвост_строк(аргументы, 1), логгер)
        возврат
    конец

    ио.строка("pan: неизвестная команда '\(команда)'")
конец
